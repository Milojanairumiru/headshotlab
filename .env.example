# Copy this file to .env and set real values. Never commit or upload .env.
# .env is blocked from static serving by serve.js.

# Required for the admin console. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_PASSCODE=

# Set to 1 when the site is served over HTTPS (Hostinger production).
COOKIE_SECURE=0

# Set to 1 only when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY=0

# Optional: store the SQLite file somewhere else (absolute path).
# HL_DB_PATH=

# Optional: port (default 8080).
# PORT=8080
